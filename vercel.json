{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "frontend",
  "functions": {
    "api/convert.py": {
      "maxDuration": 60,
      "includeFiles": "src/cosmo_tiling/config/**"
    },
    "api/conversions.py": {
      "maxDuration": 30
    },
    "api/corrections.py": {
      "maxDuration": 60,
      "includeFiles": "src/cosmo_tiling/config/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/corrections/:path*",
      "destination": "/api/corrections"
    }
  ]
}
