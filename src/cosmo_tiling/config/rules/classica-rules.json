    "ambiguous_comment": "Review - quantity left blank because the PDF does not provide a unique measurement for this product",
    "waste_rules": [
      {"name": "special_layout", "any_keywords": ["herringbone", "diagonal", "checkerboard"], "percent": 15},
      {"name": "large_stacked_horizontal", "all_keyword_groups": [["stacked", "stack", "stkd"], ["horizontal", "horizantal", "horiz"]], "min_dimension": 15, "percent": 22},
      {"name": "long_plank", "min_dimension": 36, "percent": 15},
      {"name": "large_format", "min_dimension": 15, "percent": 12},
      {"name": "floor_without_size", "applications": ["floor", "pavers"], "percent": 12},
      {"name": "standard_or_mosaic", "percent": 10}
    ]
  },
